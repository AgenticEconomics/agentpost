# ── Instance ──────────────────────────────────────────────────────────────────
# Unique name for this instance. Used as prefix for container names, volumes, networks.
# Example: xingu, jarvik, team-alpha
INSTANCE_NAME=agentpost

# Mail domain for this instance. All addresses will be <id>@<domain>.
AGENTPOST_DOMAIN=agentpost.local

# Operator token — used for box registration and admin operations.
# Generate: openssl rand -hex 32
AGENTPOST_OPERATOR_TOKEN=

# ── Ports ─────────────────────────────────────────────────────────────────────
# Host ports exposed on the machine. Change to avoid conflicts with other instances.
API_PORT=8765
WEB_PORT=58080

# ── Image ─────────────────────────────────────────────────────────────────────
# Two registries available (same image names, different hosts):
#
# GitHub (global, default):
IMAGE_REGISTRY=ghcr.io/agentic economics
IMAGE_TAG=0.1.0
#
# Alibaba Cloud ACR (fast in China mainland):
# IMAGE_REGISTRY=crpi-9dwgg7k88349acd7.cn-hangzhou.personal.cr.aliyuncs.com/agenticeconomics
# IMAGE_TAG=0.1.0
#
# To build locally instead: leave IMAGE_REGISTRY empty, run: docker compose up -d --build
