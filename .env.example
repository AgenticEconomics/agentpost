# ── Instance ──────────────────────────────────────────────────────────────────
# Unique name for this instance. Used as prefix for container names, volumes, networks.
# Example: xingu, jarvik, team-alpha
INSTANCE_NAME=agentpost

# Mail domain for this instance. All addresses will be <id>@<domain>.
AGENTPOST_DOMAIN=agentpost.local

# Operator token — used for box registration and admin operations.
# Generate: openssl rand -hex 32
AGENTPOST_OPERATOR_TOKEN=

# ── Ports ─────────────────────────────────────────────────────────────────────
# Host ports exposed on the machine. Change to avoid conflicts with other instances.
API_PORT=8765
WEB_PORT=58080

# ── Image ─────────────────────────────────────────────────────────────────────
# Pull pre-built images from ghcr.io by default.
# Set IMAGE_REGISTRY to empty string to build locally instead.
IMAGE_REGISTRY=ghcr.io/AgenticEconomics
IMAGE_TAG=0.1.0
